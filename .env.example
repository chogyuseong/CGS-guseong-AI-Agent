# 마이에이전트 환경변수 예시. 이 파일을 복사해 저장소 루트에 .env를 만들고 값을 채운다.
#   PowerShell: Copy-Item .env.example .env
# .env는 커밋하지 않는다(.gitignore가 .env*를 막고 이 파일만 예외로 둔다).
#
# 값은 작은따옴표로 감싼다. docker compose도 이 .env를 읽는데, 따옴표가 없으면 값 안의 $를
# 변수로 바꾸려 해서 값 일부가 경고로 화면에 찍힐 수 있다. 작은따옴표 안은 글자 그대로 읽힌다.

# ---- 필수 (없으면 API 서버가 시작되지 않는다) ----

# PostgreSQL 주소. 드라이버는 psycopg 3(postgresql+psycopg). docker-compose.yml의 로컬 값과 맞춘다.
DATABASE_URL='postgresql+psycopg://myagent:myagent@127.0.0.1:5432/myagent'

# 세션 쿠키 서명 키. 길고 무작위인 값으로 만든다. 바꾸면 모든 로그인이 풀린다.
#   만드는 법(apps/api에서): uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=''

# 브라우저가 화면을 여는 주소(Next.js). 상태를 바꾸는 요청은 Origin 헤더가 이 값과 같아야 한다(다르면 403).
# https로 시작하면 세션 쿠키에 Secure가 붙는다.
# 폰에서 같은 와이파이로 확인할 때는 PC의 LAN 주소로 바꾸고 API 서버를 다시 켠다. 예: 'http://192.168.0.10:3000'
APP_ORIGIN='http://localhost:3000'

# ---- LLM (1단계부터) ----

# Anthropic 콘솔에서 발급한 API 키.
ANTHROPIC_API_KEY=''
# Pydantic AI 모델 문자열('공급자:모델 ID'). 모델 ID는 Anthropic 공식 문서에서 확인한다.
#   https://platform.claude.com/docs/en/about-claude/models/overview (2026-11-16 확인)
# FAST: 일반 요청 / SMART: 한 작업의 도구 호출이 4번을 넘으면 이어 쓰는 모델 / GUARD: 감시 에이전트(2단계)
# 모델을 바꾸면 apps/api/app/config.py의 MODEL_PRICES에도 그 모델의 가격을 넣는다(없으면 비용이 0으로 기록된다).
AGENT_MODEL_FAST='anthropic:claude-haiku-5-5'
AGENT_MODEL_SMART='anthropic:claude-sonnet-5-5'
AGENT_MODEL_GUARD='anthropic:claude-haiku-5-5'

# ---- 사용량 상한 ----

# 하루 비용 상한(달러). usage_logs 합계로 검사한다.
DAILY_COST_LIMIT_USD='1.0'
# 작업 하나의 모델 요청 수 상한과 토큰 상한.
TASK_MAX_REQUESTS='12'
TASK_MAX_TOKENS='60000'

# ---- 외부 도구 (4단계부터) ----

# 카카오 로컬 API (Kakao Developers의 REST API 키)
KAKAO_REST_API_KEY=''
# 네이버 검색 API (NAVER API HUB에서 발급)
NAVER_CLIENT_ID=''
NAVER_CLIENT_SECRET=''
# Google Calendar·Gmail OAuth 클라이언트 (Google Cloud 콘솔)
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
GOOGLE_REDIRECT_URI=''
# OAuth 토큰을 DB에 암호화해 저장하는 Fernet 키.
#   만드는 법: cryptography 설치 후 Fernet.generate_key()
TOKEN_ENCRYPTION_KEY=''

# ---- 웹 푸시 (3단계부터) ----

VAPID_PUBLIC_KEY=''
VAPID_PRIVATE_KEY=''
# 'mailto:주소' 형식. 비어 있으면 푸시가 나가지 않는다.
VAPID_SUBJECT=''

# ---- 관찰 (8단계, 선택) ----

# Logfire 쓰기 토큰. 비어 있으면 아무것도 밖으로 보내지 않는다.
LOGFIRE_TOKEN=''
