# 마이에이전트 환경변수 예시. 이 파일을 복사해 저장소 루트에 .env를 만들고 값을 채운다.
#   PowerShell: Copy-Item .env.example .env
# .env는 커밋하지 않는다(.gitignore가 .env*를 막고 이 파일만 예외로 둔다).
#
# 값은 작은따옴표로 감싼다. docker compose도 이 .env를 읽는데, 따옴표가 없으면 값 안의 $를
# 변수로 바꾸려 해서 값 일부가 경고로 화면에 찍힐 수 있다. 작은따옴표 안은 글자 그대로 읽힌다.

# ---- 필수 (없으면 API 서버가 시작되지 않는다) ----

# PostgreSQL 주소. 드라이버는 psycopg 3(postgresql+psycopg). docker-compose.yml의 로컬 값과 맞춘다.
DATABASE_URL='postgresql+psycopg://myagent:myagent@127.0.0.1:5432/myagent'

# 세션 쿠키 서명 키. 길고 무작위인 값으로 만든다. 바꾸면 모든 로그인이 풀린다.
#   만드는 법(apps/api에서): uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=''

# 브라우저가 화면을 여는 주소(Next.js). 상태를 바꾸는 요청은 Origin 헤더가 이 값과 같아야 한다(다르면 403).
# https로 시작하면 세션 쿠키에 Secure가 붙는다.
# 폰에서 같은 와이파이로 확인할 때는 PC의 LAN 주소로 바꾸고 API 서버를 다시 켠다. 예: 'http://192.168.0.10:3000'
APP_ORIGIN='http://localhost:3000'

# 실행 환경: development / test / production. production이면 APP_ORIGIN이 https여야 서버가 시작된다.
APP_ENV='development'

# ---- LLM (1단계부터) ----

# Anthropic 콘솔에서 발급한 API 키.
ANTHROPIC_API_KEY=''
# Pydantic AI 모델 문자열('공급자:모델 ID'). 모델 ID는 Anthropic 공식 문서에서 확인한다.
#   https://platform.claude.com/docs/en/about-claude/models/overview (2026-11-16 확인)
# FAST: 모든 일반 요청 / SMART: 지금은 쓰지 않음(평가 근거가 생기면 명시적 정책으로 도입) / GUARD: 감시 에이전트
# 모델을 바꾸면 apps/api/app/config.py의 MODEL_PRICES에도 그 모델의 가격을 넣는다(없으면 비용이 0으로 기록된다).
AGENT_MODEL_FAST='anthropic:claude-haiku-5-5'
AGENT_MODEL_SMART='anthropic:claude-sonnet-5-5'
AGENT_MODEL_GUARD='anthropic:claude-haiku-5-5'

# ---- 사용량 상한 ----

# 하루 비용 상한(달러). usage_logs 합계로 검사한다.
DAILY_COST_LIMIT_USD='1.0'
# 작업 하나의 모델 요청 수 상한과 토큰 상한.
TASK_MAX_REQUESTS='12'
TASK_MAX_TOKENS='60000'
# 보관 기간(일). 끝난 작업의 모델 기록·단계 입력/출력·DBOS 기록 / 실행 영수증 (docs/DATA_POLICY.md)
EXECUTION_RETENTION_DAYS='7'
RECEIPT_RETENTION_DAYS='90'
# 모델 호출 한 번의 제한 시간(초).
MODEL_CALL_TIMEOUT_SECONDS='60'

# ---- 외부 도구 (4단계부터) ----

# 엔드포인트·한도 요약: docs/TOOLS.md. 날씨(Open-Meteo)는 키가 없다.
# 카카오 로컬 API (Kakao Developers의 REST API 키). search_places와 get_weather(지명 → 좌표)가 쓴다.
KAKAO_REST_API_KEY=''
# 네이버 검색 API. 네이버 개발자센터가 아니라 네이버클라우드 NAVER API HUB에서 발급한 Client ID / Client Secret.
NAVER_CLIENT_ID=''
NAVER_CLIENT_SECRET=''
# Google Calendar OAuth 클라이언트 (Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → 웹 애플리케이션)
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
# 콘솔의 '승인된 리디렉션 URI'에 등록한 값과 글자 하나까지 같아야 한다(끝에 / 없음).
# 화면 주소(APP_ORIGIN)를 거치는 콜백이어야 세션 쿠키가 함께 온다. 로컬 기본값:
GOOGLE_REDIRECT_URI='http://localhost:3000/api/connections/google/callback'
# OAuth 토큰을 DB에 암호화해 저장하는 Fernet 키. 비어 있으면 Google 연결을 쓸 수 없다. 바꾸면 다시 연결해야 한다.
#   만드는 법(apps/api에서): uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=''
# 7단계 보강: 복구 payload 암호화 Fernet 키(TOKEN_ENCRYPTION_KEY와 다른 값). DBOS 실행 기록(워크플로 입력·단계 결과)과
# 모델 기록 속 메일 결과를 암호화한다. 비어 있으면 메일 기능(Gmail)을 켜지 않는다.
# 바꾸거나 잃으면 끝나지 않은 작업을 복구할 수 없다(docs/DATA_POLICY.md 키 관리). 만드는 법은 위와 같다.
PAYLOAD_ENCRYPTION_KEY=''

# ---- 웹 푸시 (3단계부터) ----

# VAPID 키 한 쌍(P-256). 공개 키는 base64url 87자, 개인 키는 base64url 43자.
#   만드는 법: docs/PUSH-CHECK.md의 "키를 새로 만들어야 할 때". 키를 바꾸면 기기마다 '알림 켜기'를 다시 해야 한다.
VAPID_PUBLIC_KEY=''
VAPID_PRIVATE_KEY=''
# 'mailto:주소' 형식(푸시 서버가 문제를 알릴 연락처). 세 값 중 하나라도 비어 있으면 푸시가 나가지 않는다.
VAPID_SUBJECT=''

# 내구성 실행(DBOS, 3단계)은 새 변수가 없다. DATABASE_URL의 DB 안 dbos 스키마를 쓴다.

# ---- 관찰 (8단계, 선택) ----

# 관찰 데이터를 밖으로 보낼지. true로 명시하고 LOGFIRE_TOKEN도 있을 때만 보낸다. 비우거나 false면 아무것도 보내지 않는다
# (토큰만 있거나 OTEL_EXPORTER_OTLP_* 환경변수가 있어도 보내지 않는다). 바꾸면 API 서버를 다시 켜야 적용된다.
TELEMETRY_ENABLED=false

# Logfire 쓰기 토큰(Logfire 프로젝트 설정 → Write tokens에서 만든 것, pylf_v1_... 모양). TELEMETRY_ENABLED=true일 때만 쓴다.
# 보내도 트레이스에는 내용(프롬프트·답변·도구 인자와 결과·메일 본문)이 들어가지 않는다. 자세한 것은 docs/OBSERVABILITY.md.
LOGFIRE_TOKEN=''
