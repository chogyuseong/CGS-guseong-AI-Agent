# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 깃에 올라가지 않는다.
# 비어 있는 키는 그 도구를 만드는 단계에서 발급 방법을 안내받고 채운다.

# ── Django ──────────────────────────────────────────────
# 비밀 키. 생성: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# 개발 중에는 True, 배포에서는 반드시 False
DEBUG=True
# 접속을 허용할 호스트(쉼표로 구분). 폰에서 같은 와이파이로 접속하려면 PC의 IP를 추가한다.
ALLOWED_HOSTS=localhost,127.0.0.1
# 비워 두면 SQLite(db.sqlite3). 배포에서는 postgres://사용자:비밀번호@호스트:5432/DB이름
DATABASE_URL=

# ── LLM (Anthropic) ─────────────────────────────────────
# console.anthropic.com에서 발급. 구독 요금제와 별도로 청구되니 월 한도를 먼저 걸어 둔다.
ANTHROPIC_API_KEY=
# 일반 요청의 시작 모델
AGENT_MODEL_FAST=claude-haiku-5-5
# Step이 4개를 넘은 Task가 남은 호출에 쓰는 모델
AGENT_MODEL_SMART=claude-sonnet-5-5
# 외부 행동 전에 요청과 행동이 맞는지 검사하는 감시 모델
AGENT_MODEL_GUARD=claude-haiku-5-5

# ── 비용과 단계 상한 ────────────────────────────────────
# 하루 전체 LLM 비용 상한(달러)
DAILY_COST_LIMIT_USD=1.0
# Task 하나가 만들 수 있는 최대 Step 수
TASK_MAX_STEPS=12
# Task 하나가 쓸 수 있는 최대 토큰 수(입력+출력 누적)
TASK_MAX_TOKENS=60000

# ── 외부 도구 API ───────────────────────────────────────
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키 (장소 검색, 날씨용 좌표 변환)
KAKAO_REST_API_KEY=
# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API (웹 검색)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Google Cloud Console > OAuth 클라이언트 ID(웹 애플리케이션) (캘린더, 메일 읽기)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 예: http://localhost:8000/connections/google/callback/
GOOGLE_REDIRECT_URI=

# ── 암호화와 푸시 ───────────────────────────────────────
# OAuth 토큰 암호화 키(Fernet). 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# 웹 푸시 VAPID 키 쌍. 3단계에서 생성 방법을 안내한다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 연락할 주소. 예: mailto:me@example.com
VAPID_SUBJECT=
